{
  "name": "sender-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A Claude agent with its own tools and a code-enforced send guard, rebuilt from a partner outreach sender.",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
